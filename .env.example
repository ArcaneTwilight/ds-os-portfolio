# Optional PostHog analytics configuration.
# Vite exposes VITE_ variables in the client bundle; use only a PostHog project key.
# Leave the key empty to disable analytics.
VITE_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com. Set this for another PostHog region or self-hosted instance.
VITE_POSTHOG_HOST=
